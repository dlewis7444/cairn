# Cairn environment configuration
# Copy this file to .env.local and fill in your values.

# === Server ===
CAIRN_PORT=3847
CAIRN_BIND=0.0.0.0
# IANA timezone name.
CAIRN_TZ=UTC
# Absolute URL the email digest links back to. Leave blank to omit the link.
CAIRN_PUBLIC_URL=

# === Auth ===
# Required on all /api/* routes (except /health).
# Enter this value at the browser's "Bearer token (one-time):" prompt.
# Generate with: openssl rand -hex 32
CAIRN_BEARER_TOKEN=

# === Email (outbound digest) ===
# Optional: leave SMTP_TO blank to disable mail.
# Gmail requires an app password; SMTP_FROM must be that account or an alias.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cairn <cairn@example.com>"
SMTP_TO=

# === Backup ===
# rsync destination, e.g. user@backup-host:/path/to/backups/
BACKUP_RSYNC_TARGET=

# === Search (used by script-type automations that need web search) ===
# SearXNG base URL. Must have the JSON API enabled (`/search?q=...&format=json`).
# Blank disables the headlines runner.
CAIRN_SEARXNG_URL=

# === UI header notes ===
# Shown, italicized, to the right of each section's title. One line, ellipsized.
CAIRN_HEADER_MORNING_COFFEE="It would be good if you made these your morning habits"
CAIRN_HEADER_THE_CAIRN="This is not a todo list but a 'watch list' - these are things you want to keep aware of, not tasks you have to do"

# === AI provider secrets ===
# Structure of providers/models lives in config/config.toml under [ai].
# Only the actual API keys go here — referenced by `api_key_env` in the TOML.
# ANTHROPIC_API_KEY=
# OLLAMA_API_KEY=
